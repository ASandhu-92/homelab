# Copy to .env and fill in. .env is git-ignored.
# Only read on first start; later changes go through the console or API.

# Name the server uses for itself (shows in the console and in SOA records).
DNS_SERVER_DOMAIN=dns.example.com

# Console admin password. Generate one: openssl rand -base64 24
DNS_SERVER_ADMIN_PASSWORD=

# Blocklists (comma-separated). These two are what I run: Hagezi Multi PRO and
# Hagezi Threat Intelligence Feeds (medium), "onlydomains" format.
DNS_SERVER_BLOCK_LIST_URLS=https://cdn.jsdelivr.net/gh/hagezi/dns-blocklists@latest/wildcard/pro-onlydomains.txt,https://cdn.jsdelivr.net/gh/hagezi/dns-blocklists@latest/wildcard/tif.medium-onlydomains.txt

TZ=UTC

# Used by split-brain.py (not by the container).
TECHNITIUM_URL=http://127.0.0.1:5380
LAB_ZONE=example.com
PROXY_IP=192.0.2.10
