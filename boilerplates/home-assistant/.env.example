# Copy to .env and fill in. .env must be gitignored.

TZ=Etc/UTC

# --- AI assistant / MCP integration (optional) ---
# Long-lived access token created in the HA UI (Profile -> Security ->
# Long-Lived Access Tokens). Consumed by an external MCP/REST client, NOT by
# the HA container itself. Treat as a secret: store in a secret manager, never
# commit the real value, rotate periodically.
HA_URL=https://home.example.com
HA_TOKEN=
