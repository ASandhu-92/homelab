# Copy to .env and fill in. .env is git-ignored.

# Base domain for all routers. Routers are built as <service>.${DOMAIN}.
DOMAIN=example.com

# Email Let's Encrypt uses for expiry notices and the ACME account.
ACME_EMAIL=admin@example.com

# Cloudflare API token for the DNS-01 challenge.
# Create at: Cloudflare dashboard > My Profile > API Tokens.
# Scope: Zone > DNS > Edit, restricted to your zone only.
CF_DNS_API_TOKEN=
