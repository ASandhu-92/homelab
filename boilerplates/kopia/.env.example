# Copy to .env and fill in. .env must be gitignored.

# Credentials for the Kopia web UI / API (server auth, separate from the repo).
KOPIA_SERVER_USER=admin
KOPIA_SERVER_PASSWORD=

# Repository encryption password. THIS ENCRYPTS THE BACKUPS.
# If you lose it, the data is unrecoverable: store it in a secret manager
# and keep an offline copy. Never commit the real value.
KOPIA_REPOSITORY_PASSWORD=

TZ=Etc/UTC
