# Copy to .env and fill in. .env is git-ignored.

# LAN address the ports bind to. Nothing here should face the internet.
BIND_IP=192.0.2.30

# API key clients use for LiteLLM. Must start with "sk-". Generate one:
#   echo "sk-$(openssl rand -hex 24)"
LITELLM_MASTER_KEY=

# SearXNG JSON endpoint for Vane (the searxng folder's instance).
SEARXNG_API_URL=http://192.0.2.10:8080

TZ=UTC
