# Copy to .env and fill in. .env is git-ignored.

# Base domain. Session cookie is scoped here so SSO spans all subdomains.
DOMAIN=example.com

# Timezone for logs / TOTP.
TZ=UTC

# Secrets: generate each with:  openssl rand -hex 64
# These MUST be long random values and must never be committed.
AUTHELIA_JWT_SECRET=
AUTHELIA_SESSION_SECRET=
AUTHELIA_STORAGE_ENCRYPTION_KEY=
