# Copy to .env and fill in. .env must be gitignored.

# --- PostgreSQL backing store ---
POSTGRES_DB=n8n
POSTGRES_USER=admin
POSTGRES_PASSWORD=

# --- Public URL behind the reverse proxy ---
# Hostname n8n is served on, and the FULL external URL used for webhook
# callbacks and editor links. These must match your proxy route.
N8N_HOST=n8n.example.com
WEBHOOK_URL=https://n8n.example.com/

# --- Credential encryption ---
# Generate once and NEVER change it, or all stored credentials become unreadable.
#   openssl rand -hex 32
N8N_ENCRYPTION_KEY=

TZ=Etc/UTC
