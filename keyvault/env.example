# Copy to /etc/keyvault/env (root:root, mode 600). Read by keyvault.service.
KV_STORE=/srv/secrets/secrets.enc.env
KV_SOPS_CONFIG=/srv/secrets/.sops.yaml
KV_AUDIT=/var/log/keyvault/keyvault.log
# The Docker network gateway Traefik reaches the host on.
KV_BIND=172.24.0.1:8094
KV_TRUSTED_NETS=172.24.0.0/16,127.0.0.0/8
# SSO user names allowed to write (the Remote-User header from Authelia).
KV_ALLOWED_USERS=admin
KV_ORIGIN=https://kv.example.com
# Same value as X-Kv-Edge in traefik-keyvault.yml. openssl rand -hex 24
KV_EDGE_SECRET=
