# Copy to .env and fill in. .env is git-ignored.

# Browser-facing URL of the manager, exactly as typed in the address bar.
APP_URL=https://arc.example.com

# Directory that holds one folder per compose project, on the host.
STACKS_DIR=/srv/stacks

TZ=UTC

# Secrets are files, not variables. Before first start:
#   mkdir -p secrets
#   openssl rand -hex 32 | tr -d '\n' > secrets/encryption_key
#   openssl rand -hex 32 | tr -d '\n' > secrets/jwt_secret
#   chmod 600 secrets/*
